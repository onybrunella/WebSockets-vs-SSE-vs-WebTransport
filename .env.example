# Copiez vers .env à la racine pour docker compose / build frontend.
# Ne commitez pas de secrets.

# Origines autorisées pour l'API SSE (ou * en démo)
CORS_ORIGINS=*

# URLs vues par le navigateur (frontend build)
WS_URL=ws://localhost:3001
SSE_URL=http://localhost:3002
WT_URL=https://127.0.0.1:3003
