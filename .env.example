# Copier vers .env à la racine (ne pas committer .env)

# CORS du serveur SSE (* en démo, sinon URL du front)
CORS_ORIGINS=*

# URLs vues par le navigateur (Docker / Vercel)
# Sur un VPS, remplace localhost par ton IP ou domaine.
WS_URL=ws://localhost:3001
SSE_URL=http://localhost:3002
WT_URL=https://127.0.0.1:3003
